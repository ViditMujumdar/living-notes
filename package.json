{
  "name": "living-notes",
  "version": "1.0.0",
  "private": true,
  "description": "Turn photographs of textbook physics diagrams into interactive experiments.",
  "type": "module",
  "engines": { "node": ">=22.13" },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build && node scripts/build-server.mjs",
    "start": "node --env-file-if-exists=.env dist-server/index.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "verify:live": "node scripts/verify-live.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "@hono/node-server": "2.1.5",
    "@vitejs/plugin-react": "6.1.2",
    "dompurify": "3.4.17",
    "esbuild": "0.28.2",
    "hono": "4.13.14",
    "katex": "0.19.1",
    "marked": "18.1.2",
    "qrcode": "1.5.4",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "vite": "8.3.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
