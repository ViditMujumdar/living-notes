# Living Notes: server configuration. Copy to .env for local development.
# Never commit real keys. On Embarko, set these as app environment variables.

# --- AI (diagram reading + tutor) -------------------------------------------
# Google Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Multimodal model to use. Check https://aistudio.google.com/docs/models for current stable codes.
GEMINI_MODEL=gemini-3.6-flash
# Optional: retried once if the main model is overloaded (HTTP 503). Leave empty to disable.
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# Request timeout in ms (default 45000)
# AI_TIMEOUT_MS=45000

# --- Web search (Find supporting sources) ------------------------------------
# Brave Search API key from https://api-dashboard.search.brave.com/
BRAVE_SEARCH_API_KEY=
# SEARCH_TIMEOUT_MS=10000

# --- Storage ------------------------------------------------------------------
# Folder for the SQLite database that stores public share links.
# Embarko sets DATA_DIR automatically (persistent across redeploys). Locally defaults to ./.data
# DATA_DIR=./.data

# --- Public URL -----------------------------------------------------------------
# Used to build share links and QR codes, e.g. https://living-notes.embarko.app
PUBLIC_APP_URL=

# --- Server ---------------------------------------------------------------------
# PORT is provided by the host. Locally the API runs on 8787.
# PORT=8787
# MAX_UPLOAD_BYTES=8388608

# --- Test-only overrides (do not set in production) -------------------------------
# GEMINI_API_BASE / BRAVE_API_BASE point the real adapters at a local mock in automated tests.
